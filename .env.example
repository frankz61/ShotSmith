APP_ENV=dev
DATABASE_URL=mysql+pymysql://shotsmith:password@localhost:23306/shotsmith?charset=utf8mb4
REDIS_URL=redis://:password@localhost:26379/0
STORAGE_DIR=./data

# 对象存储：local(本地磁盘 + /files 静态服务) / oss(阿里云 OSS：服务端签名直传 + 预签名访问)
STORAGE_BACKEND=local
# 阿里云 OSS（STORAGE_BACKEND=oss 时必填）。直传需在 OSS 控制台为 Bucket 配置 CORS：
# 允许来源=前端域名、方法=PUT/GET、允许 Headers=*
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# V4 签名必填地域 ID（不带 oss- 前缀）
OSS_REGION=cn-hangzhou
# 同地域 ECS 可填内网 endpoint（服务端上传/下载免公网流量），留空用 OSS_ENDPOINT
OSS_INTERNAL_ENDPOINT=
# 预签名 URL 有效期（秒）
OSS_URL_TTL=3600
# 缩略图实时处理参数（x-oss-process），列表/网格只拉小图提速；
# format,webp 必须有：源多为 PNG，quality 仅对 jpg/webp 生效
OSS_THUMB_PROCESS=image/resize,w_480/quality,q_85/format,webp

# 模型 Provider
# matting: rembg(质量优,需 .[matting]) / simple(纯 Pillow,离线可跑)
MATTING_PROVIDER=rembg
# rembg 模型: birefnet-general(最佳) / birefnet-general-lite(更快) / u2net
MATTING_MODEL=birefnet-general
# 抠图推理设备: auto(装了 GPU 版 onnxruntime 即自动用显卡) / cpu(强制 CPU)
# Windows AMD/Intel 显卡装 pip install -e ".[matting-dml]"（DirectML）
MATTING_DEVICE=auto
# imagegen: openrouter_image(OpenRouter·Gemini 生图，默认) / local(离线纯色合成兜底) / vendor_a
IMAGEGEN_PROVIDER=openrouter_image
FIDELITY_PROVIDER=simple

# 商用图像 API（vendor_a 时填）
IMAGEGEN_API_KEY=
IMAGEGEN_API_BASE=

# 在线生图前先用 VLM 结合去背景图生成场景提示词；失败自动回落模板
PROMPT_VLM_ENABLED=true
# OpenRouter 统一网关：VLM 看图写提示词 + Gemini 生图（openrouter_image 引擎）
OPENROUTER_API_KEY=
# 视觉识别模型：仅当创意模型不支持图片输入时用于两段式回落（须支持 image 输入）
OPENROUTER_VLM_MODEL=google/gemini-3.1-flash-lite
# 创意模型：为每张场景图各生成一条创意提示词；支持图片输入的模型（如 openai/gpt-5.5）
# 单段看图直出，纯文本模型（如 deepseek/deepseek-v4-pro）自动回落两段式
OPENROUTER_TEXT_MODEL=openai/gpt-5.5
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
# 出图分辨率档位：0.5K / 1K / 2K / 4K（最终会缩放到导出尺寸）
OPENROUTER_IMAGE_SIZE=1K

FIDELITY_THRESHOLD=0.85
