APP_ENV=dev
DATABASE_URL=mysql+pymysql://shotsmith:password@localhost:23306/shotsmith?charset=utf8mb4
REDIS_URL=redis://:password@localhost:26379/0
STORAGE_DIR=./data

# 模型 Provider
# matting: rembg(质量优,需 .[matting]) / simple(纯 Pillow,离线可跑)
MATTING_PROVIDER=rembg
# rembg 模型: birefnet-general(最佳) / isnet-general-use / u2net
MATTING_MODEL=birefnet-general
# imagegen: local(离线合成) / aliyun_bg(阿里通义万相·背景生成) / vendor_a(其它商用 API)
IMAGEGEN_PROVIDER=local
FIDELITY_PROVIDER=simple

# 商用图像 API（vendor_a 时填）
IMAGEGEN_API_KEY=
IMAGEGEN_API_BASE=

# 阿里通义万相·背景生成（IMAGEGEN_PROVIDER=aliyun_bg 时填，需 pip install -e '.[aliyun]'）
DASHSCOPE_API_KEY=
# 一般无需改：模型/版本/噪声/文本权重/轮询参数
ALIYUN_BG_MODEL=wanx-background-generation-v2
ALIYUN_BG_MODEL_VERSION=v2
ALIYUN_BG_NOISE_LEVEL=300
ALIYUN_BG_REF_PROMPT_WEIGHT=0.5
ALIYUN_POLL_INTERVAL=3.0
ALIYUN_POLL_TIMEOUT=180.0

FIDELITY_THRESHOLD=0.85
