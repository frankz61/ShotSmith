{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1) Init DB (建表)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/init_db.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "2) FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "28000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "3) Celery worker",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": [
        "-A", "app.tasks.celery_app.celery_app", "worker",
        "--loglevel=info", "--pool=solo"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "4) 前端 (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "全部启动 (API + Worker + 前端)",
      "configurations": [
        "2) FastAPI (uvicorn)",
        "3) Celery worker",
        "4) 前端 (Vite)"
      ],
      "stopAll": true
    }
  ]
}
